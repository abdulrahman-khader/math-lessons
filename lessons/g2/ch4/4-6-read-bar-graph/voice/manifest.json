{
 "00-fe25ea308602.mp3": {
  "text": "فِكْرَةُ الدَّرْسِ: قِرَاءَةُ الْبَيَانَاتِ الْمُمَثَّلَةِ بِالأَعْمِدَةِ.",
  "d": 4.66,
