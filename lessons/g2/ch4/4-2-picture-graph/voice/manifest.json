{
 "00-30a62e6b526b.mp3": {
  "text": "فِكْرَةُ الدَّرْسِ: التَّمْثِيلُ بِالصُّوَرِ.",
  "d": 3.31
 },
 "01-eb398b240192.mp3": {
  "text": "كُلُّ صُورَةٍ تُمَثِّلُ طَالِبًا وَاحِدًا.",
  "d": 3.17
 },
 "02-1e4644d1a0c0.mp3": {
  "text": "الْكُرَةُ: سِتُّ صُوَرٍ.",
  "d": 2.4699999999999998
 },
 "03-374e31b57bb1.mp3": {
  "text": "الدَّرَّاجَةُ: أَرْبَعُ صُوَرٍ.",
  "d": 2.8
 },
 "04-e9aba5ba0d3f.mp3": {
  "text": "الْمِفْتَاحُ يُخْبِرُنَا كَمْ تُمَثِّلُ الصُّورَةُ.",
  "d": 3.12
 },
 "05-79a5454e7676.mp3": {
  "text": "نُغَيِّرُ الْمِفْتَاحَ: كُلُّ صُورَةٍ تُمَثِّلُ طَالِبَيْنِ.",
  "d": 4.61
 },
 "06-6adbc71408be.mp3": {
  "text": "الْكُرَةُ: سِتَّةُ طُلَّابٍ، أَيْ ثَلَاثُ صُوَرٍ فَقَطْ.",
  "d": 4.5200000000000005
 },
 "07-63d66c90aa55.mp3": {
  "text": "الدَّرَّاجَةُ: أَرْبَعَةُ طُلَّابٍ، أَيْ صُورَتَانِ.",
  "d": 4.5200000000000005
