{
 "00-869c2d17df82.mp3": {
  "text": "فِكْرَةُ الدَّرْسِ: أُنْشِئُ جَدْوَلًا.",
  "d": 2.8
 },
 "01-7175c8d45923.mp3": {
  "text": "نُنْشِئُ جَدْوَلًا: صَفٌّ لِلدَّرَّاجَاتِ، وَصَفٌّ لِلْعَجَلَاتِ.",
  "d": 5.58
 },
 "02-d45dda96bb88.mp3": {
  "text": "دَرَّاجَةٌ وَاحِدَةٌ: عَجَلَتَانِ.",
  "d": 3.2199999999999998
 },
 "03-8e055d780c44.mp3": {
  "text": "دَرَّاجَتَانِ: أَرْبَعُ عَجَلَاتٍ.",
  "d": 2.84
 },
 "04-f4c25952dc16.mp3": {
  "text": "نَعُدُّ بِالاثْنَيْنِ: سِتَّةٌ، ثَمَانِيَةٌ، عَشَرَةٌ.",
  "d": 5.21
 },
 "05-f4f70e7503ae.mp3": {
  "text": "سِتُّ دَرَّاجَاتٍ: اثْنَتَا عَشْرَةَ عَجَلَةً.",
  "d": 3.77
 },
 "06-93d582bbb0c3.mp3": {
  "text": "نَتَحَقَّقُ بِالْجَمْعِ الْمُتَكَرِّرِ.",
  "d": 2.57
 }
}
